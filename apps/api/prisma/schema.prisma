generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])

  passwordResetTokens PasswordResetToken[]
  jobs                Job[]
  userProfile         userProfile?
  // Due to Prisma limitation, we cannot enforce the rule of: "Each User must have one UserProfile"
  // What we can enforce, is commented at model userProfile.
  userJobPreference   userJobPreference?

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]

  @@map("roles")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  users User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Job {
  id                  String         @id @default(uuid())
  createdByEmployerId String         @map("created_by_employer_id")
  companyId           String         @map("company_id")
  title               String
  description         String
  requirement         String
  employmentType      EmploymentType @map("employment_type")
  location            String
  status              JobStatus
  deadline            DateTime
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime?      @default(now()) @map("updated_at")
  closedAt            DateTime?      @map("closed_at")
  deletedAt           DateTime?      @map("deleted_at")
  approvedAt          DateTime?      @map("approved_at")
  rejectedAt          DateTime?      @map("rejected_at")
  rejectionReason     String?        @map("rejection_reason")

  user    User    @relation(fields: [createdByEmployerId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@map("jobs")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  district  String?
  city      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  jobs Job[]

  @@map("companies")
}

model userProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  fullName    String   @map("full_name")
  headline    String?
  summary     String?
  phoneNumber String?  @map("phone_number")
  city        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  // We can enfore that:
  // "Each userProfile must belong to only one user"
  // "Each user can have at most one userProfile"
  // Both of these are enforcable since userId is unique

  @@map("user_profiles")
}

model userJobPreference {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  profileVisibility profileVisibility @map("profile_visibility")
  jobSearchStatus   jobSearchStatus   @map("job_search_status")
  desiredJobTitle   String            @map("desired_job_title")
  preferredLocation String            @map("preffered_location")

  user User @relation(fields: [userId], references: [id])

  @@map("user_job_preference")
}

enum EmploymentType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CLOSED
  EXPIRED
  DELETED
}

enum profileVisibility {
  PUBLIC
  VISIBLE_TO_EMPLOYER
  PRIVATE
}

enum jobSearchStatus {
  OPEN_FOR_JOBS
  CLOSED
}
